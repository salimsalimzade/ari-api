APP_CORS_ALLOWED_ORIGINS=
# The website, for links in emails
APP_WEB_URL=
# ari-api as browsers reach it, for Google sign-in's way back (http://localhost:8080 when left out)
APP_API_URL=
SERVER_PORT=
# PostgreSQL is Supabase's: `supabase start` serves it on 54322
#   (DB_URL=jdbc:postgresql://127.0.0.1:54322/postgres, DB_USERNAME=postgres, DB_PASSWORD=postgres).
#   For a hosted project, use its session pooler's host, user and database password.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# Supabase Auth keeps the accounts and sessions. `supabase status` prints the local values:
#   SUPABASE_URL=http://127.0.0.1:54321, SUPABASE_SECRET_KEY=its "Secret" key (sb_secret_...).
#   A hosted project: Project Settings, API Keys. The secret key stays on the server.
SUPABASE_URL=
# Only when browsers reach Supabase at another address than ari-api does (ari-api in Docker)
SUPABASE_PUBLIC_URL=
SUPABASE_SECRET_KEY=
# Google sign-in: a Google Cloud OAuth client (Web application) whose authorized redirect URI is
# http://127.0.0.1:54321/auth/v1/callback locally. `supabase start` reads these two from this file;
# a hosted project takes them in Authentication, Sign In / Providers, Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# The Supabase CLI's own: a personal access token (`supabase link`, deploys) and the hosted
# project's database password. ari-api reads neither.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DATABASE_PASSWORD=
# Redis from `docker compose up -d redis`
REDIS_URL=
# RabbitMQ from `docker compose up -d rabbitmq` (Mailpit needs no settings)
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
# Mailpit from `docker compose up -d mailpit`; its inbox is http://localhost:8025
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=
MAIL_SSL=
APP_MAIL_FROM=
# To deliver real emails, replace the mail values above with a provider's (and restart the API):
#   Gmail, with an app password (needs 2-Step Verification on the Google account):
#     MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_STARTTLS=true,
#     MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=the 16-letter app password,
#     APP_MAIL_FROM=Ari <you@gmail.com> (Gmail sends only from your own address)
#   Brevo, free up to 300 a day (verify the sender address in Brevo first):
#     MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587, MAIL_STARTTLS=true,
#     MAIL_USERNAME=the SMTP login, MAIL_PASSWORD=the SMTP key, APP_MAIL_FROM=Ari <verified address>
# The API in docker compose uses MAIL_DOCKER_HOST instead of MAIL_HOST (mailpit by default), so set
# it to the provider's host too.
# MinIO from `docker compose up -d minio`; the console is http://localhost:9001 (log in with the key
# and secret).
STORAGE_ENDPOINT=
STORAGE_PUBLIC_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
# false only for http://localhost; production keeps the default (true)
APP_COOKIE_SECURE=
APP_COOKIE_DOMAIN=
APP_SEED_DEMO_DATA=
