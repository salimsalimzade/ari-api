APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVER_PORT=8080
# PostgreSQL from `docker compose up -d postgres`
DB_URL=jdbc:postgresql://localhost:5432/ari
DB_NAME=ari
DB_USERNAME=ari
DB_PASSWORD=ari-local-only
# At least 32 characters; generate one with: openssl rand -base64 48
APP_JWT_SECRET=local-only-jwt-secret-change-me-0123456789
# false only for http://localhost; production keeps the default (true)
APP_COOKIE_SECURE=false
APP_COOKIE_DOMAIN=
APP_SEED_DEMO_DATA=true
