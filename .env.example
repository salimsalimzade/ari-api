APP_CORS_ALLOWED_ORIGINS=
# The website, for links in emails
APP_WEB_URL=
SERVER_PORT=
# PostgreSQL from `docker compose up -d postgres`
DB_URL=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# Redis from `docker compose up -d redis`
REDIS_URL=
# RabbitMQ from `docker compose up -d rabbitmq` (Mailpit needs no settings)
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
# Mailpit from `docker compose up -d mailpit`; its inbox is http://localhost:8025
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=
MAIL_SSL=
APP_MAIL_FROM=
# To deliver real emails, replace the mail values above with a provider's (and restart the API):
#   Gmail, with an app password (needs 2-Step Verification on the Google account):
#     MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_STARTTLS=true,
#     MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=the 16-letter app password,
#     APP_MAIL_FROM=Ari <you@gmail.com> (Gmail sends only from your own address)
#   Brevo, free up to 300 a day (verify the sender address in Brevo first):
#     MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587, MAIL_STARTTLS=true,
#     MAIL_USERNAME=the SMTP login, MAIL_PASSWORD=the SMTP key, APP_MAIL_FROM=Ari <verified address>
# The API in docker compose uses MAIL_DOCKER_HOST instead of MAIL_HOST (mailpit by default), so set
# it to the provider's host too.
# MinIO from `docker compose up -d minio`; the console is http://localhost:9001 (log in with the key
# and secret).
STORAGE_ENDPOINT=
STORAGE_PUBLIC_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
# At least 32 characters; generate one with: openssl rand -base64 48
APP_JWT_SECRET=
# false only for http://localhost; production keeps the default (true)
APP_COOKIE_SECURE=
APP_COOKIE_DOMAIN=
APP_SEED_DEMO_DATA=
